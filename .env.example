# Copy to .env.local (never commit that file). Everything here is public by design: it is sent to the browser.

# Sign-in on the website (/account). Supabase > Project Settings > API: the project URL and the publishable key.
# NEVER put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Where the Arrivo API is. Default: http://localhost:4000 under `npm run dev`, the live API in a build.
NEXT_PUBLIC_API_URL=

# Optional. The website's own address, for links and metadata. Default: https://tryarrivo.com
NEXT_PUBLIC_SITE_URL=
